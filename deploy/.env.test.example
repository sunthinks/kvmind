# kdkvm test-setup.sh 本地环境变量模板
#
# 用法：
#   cp .env.test.example .env.test.local
#   # 编辑 .env.test.local 填入真实 Key（该文件被根 .gitignore 覆盖，不会误提交）
#   set -a && source dev/kdkvm/deploy/.env.test.local && set +a
#   ./dev/kdkvm/deploy/test-setup.sh 192.168.0.22
#
# 获取 Gemini Key：https://aistudio.google.com/apikey

# Google AI Studio API Key（AIza 开头，39 位）
GEMINI_KEY=REPLACE_ME

# 可选：本地 Ollama 地址（默认 http://192.168.0.12:11434/v1）
# OLLAMA_URL=http://192.168.0.12:11434/v1
